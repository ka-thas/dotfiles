Host *
  SetEnv LANG=C
  ControlMaster auto
  ControlPath /tmp/%r@%h:%p
  Compression yes
  ControlPersist 10m
  ForwardX11 yes
  ForwardX11Trusted yes
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 5


Host katabasis
  HostName katabasis.local
  User kathas
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes


Host uio
  HostName login.uio.no
  User kavint
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

